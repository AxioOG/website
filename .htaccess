<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Handle dashboard route
  RewriteRule ^dashboard/?$ dashboard.html [L]
  
  # Handle home route
  RewriteRule ^home/?$ index.html [L]
  
  # Handle pricing route
  RewriteRule ^pricing/?$ index.html [L]
  
  # Handle status route
  RewriteRule ^status/?$ index.html [L]
  
  # Redirect all non-file/non-directory requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Enable CORS for images and fonts
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type"
</IfModule>

# Cache control for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>
